# 공공데이터포털 일반 인증키 (Decoding)
VITE_DATA_GO_KR_KEY=sample

# 서울 열린데이터광장 인증키
VITE_SEOUL_API_KEY=sample

# 카카오 디벨로퍼스 JavaScript 키
VITE_KAKAO_JS_KEY=sample

# 아래는 브라우저에 노출되면 안 되는 값 (VITE_ 접두사 없음 = 클라이언트 번들에 안 들어감)
# scripts/kakao-token.js, scripts/send-briefing.js 에서만 사용

# 카카오 디벨로퍼스 REST API 키
KAKAO_REST_API_KEY=sample

# 카카오 로그인 > 보안 > 클라이언트 시크릿 (활성화 상태여야 함)
KAKAO_CLIENT_SECRET=sample

# 카카오 로그인 리다이렉트 URI에 등록한 값과 동일해야 함 (kakao-token.js 발급용)
KAKAO_REDIRECT_URI=http://localhost:5173/kakao/callback

# kakao-token.js로 발급받은 refresh_token (GitHub Secrets에도 동일하게 등록)
KAKAO_REFRESH_TOKEN=sample

# 공공데이터포털/서울열린데이터광장 키 (scripts용, VITE_ 버전과 동일 값)
DATA_GO_KR_KEY=sample
SEOUL_API_KEY=sample
